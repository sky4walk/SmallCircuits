    <comp lib="6" loc="(260,900)" name="Text">
      <a name="text" val="Adressstapel wie im 4004: vier 12-Bit-Adressregister, SP zeigt auf das aktuelle (= Programmzaehler)."/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(260,920)" name="Text">
      <a name="text" val="JMS: SP+1 und Ziel dort ablegen, BBL: SP-1. Damit drei Unterprogrammebenen; Ueberlauf rotiert wie im Original."/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(260,940)" name="Text">
      <a name="text" val="PCSEL: 0 = PC+1, 1 = Seite+O2 (JCN/ISZ), 2 = OPA+O2 (JUN/JMS), 3 = Seite+Registerpaar (JIN)."/>
      <a name="halign" val="left"/>
    </comp>
