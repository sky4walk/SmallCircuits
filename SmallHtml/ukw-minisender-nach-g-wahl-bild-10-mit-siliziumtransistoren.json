 "texts": [
  {
   "id": "t40",
   "x": 100,
   "y": 600,
   "text": "Nach G. Wahl, Minispione I, Bild 10 - Fassung mit Siliziumtransistoren.",
   "size": 13
  },
  {
   "id": "t41",
   "x": 100,
   "y": 620,
   "text": "T1: 2N2369A oder BF199 statt 2N708 (nicht mehr erhaeltlich), sonst gleich.",
   "size": 13
  },
  {
   "id": "t42",
   "x": 100,
   "y": 640,
   "text": "T3: BC557 statt AC122 - ohne weitere Aenderung, der Emitterfolger arbeitet so.",
   "size": 13
  },
  {
   "id": "t43",
   "x": 100,
   "y": 660,
   "text": "T2: BC557 statt AC122 UND neu R6 = 1 MOhm von der Basis nach Masse.",
   "size": 13
  },
  {
   "id": "t44",
   "x": 100,
   "y": 680,
   "text": "Der Germaniumtyp bezog seinen Basisstrom aus dem eigenen Leckstrom (Mikroampere),",
   "size": 13
  },
  {
   "id": "t45",
   "x": 100,
   "y": 700,
   "text": "Silizium hat davon nur Nanoampere - R6 liefert jetzt gezielt 8 uA.",
   "size": 13
  },
  {
   "id": "t46",
   "x": 100,
   "y": 720,
   "text": "R6 zwischen 470 k und 2,2 M probieren: bestimmt Hub und Klang.",
   "size": 13
  },
  {
   "id": "t47",
   "x": 100,
   "y": 750,
   "text": "L1: 7 Wdg 1 mm auf 5 mm, Anzapfung X bei 1-1,5 Wdg (L1a). L2: 1-2 Wdg.",
   "size": 13
  },
  {
   "id": "t48",
   "x": 100,
   "y": 770,
   "text": "Betrieb auf dem UKW-Rundfunkband ist in Deutschland nicht zulaessig.",
   "size": 13
  }
 ],
