 "texts": [
  {
   "id": "t40",
   "x": 40,
   "y": 530,
   "text": "Drei Stufen: links der Mikrofonverstaerker, in der Mitte die",
   "size": 13
  },
  {
   "id": "t41",
   "x": 40,
   "y": 550,
   "text": "Kapazitaetsdiode als Modulator, rechts der Colpitts-Oszillator.",
   "size": 13
  },
  {
   "id": "t42",
   "x": 40,
   "y": 570,
   "text": "Die NF verschiebt ueber D1 die Kapazitaet und damit die Frequenz.",
   "size": 13
  },
  {
   "id": "t43",
   "x": 40,
   "y": 590,
   "text": "L2 ist magnetisch mit L1 gekoppelt - keine galvanische Verbindung.",
   "size": 13
  },
  {
   "id": "t44",
   "x": 40,
   "y": 630,
   "text": "L1 0,2 uH mit C4/C5 und dem Varaktorzweig: rund 97 MHz.",
   "size": 13
  },
  {
   "id": "t45",
   "x": 40,
   "y": 650,
   "text": "Betrieb auf dem UKW-Rundfunkband ist in Deutschland nicht zulaessig.",
   "size": 13
  },
  {
   "id": "t46",
   "x": 40,
   "y": 670,
   "text": "Als Lehrobjekt an einem Abschlusswiderstand statt an einer Antenne.",
   "size": 13
  }
 ],
